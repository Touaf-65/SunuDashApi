# Copier ce fichier en .env et renseigner les valeurs.
# En production (Render), définir ces variables dans le dashboard du service.

# Mettre True uniquement en développement local
DJANGO_DEBUG=False
# Générer avec : python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=sunudashapi.onrender.com,127.0.0.1,localhost

CORS_ALLOWED_ORIGINS=http://localhost:4200,https://sunudash.netlify.app
FRONTEND_URL=https://sunudash.netlify.app

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

CELERY_BROKER_URL=redis://localhost:6379/0
